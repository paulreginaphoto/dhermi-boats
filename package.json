{
  "name": "dhermi-boats-static",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/build-translations.mjs && next build && node ./scripts/strip-next-runtime.mjs",
    "export": "npm run build",
    "test:date-format": "node ./scripts/booking-date-format.test.mjs",
    "translations": "node ./scripts/build-translations.mjs",
    "qa:conversion-ux": "node ./scripts/qa-conversion-ux.mjs",
    "qa:final-release": "node ./scripts/qa-final-release.mjs",
    "qa:i18n-links": "node ./scripts/qa-i18n-links.mjs",
    "qa:minimal-homepage": "node ./scripts/qa-minimal-homepage.mjs",
    "qa:url-canonicals": "node ./scripts/qa-url-canonicals.mjs",
    "content:guard": "node ./scripts/content-guard.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.19",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
